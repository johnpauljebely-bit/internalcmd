# Port the Express server listens on locally.
PORT=3000

# Shared Postgres instance — same database the delta-city-cad website reads from. Local dev
# default assumes `brew services start postgresql@16` + a `delta_city_app` role (see
# NEEDS_HUMAN_VERIFICATION.md for exact provisioning steps used).
DATABASE_URL=postgres://delta_city_app@localhost:5432/delta_city

# Shared secret for the CAD website's POST /internal/announce calls (BOT_SIDE_INSTRUCTIONS.md
# #4). Must match BOT_INTERNAL_API_SECRET in the CAD's own .env.local.
INTERNAL_API_SECRET=

# ER:LC private server API key (server-key header for api.erlc.gg/v2 calls).
ERLC_SERVER_KEY=

# ER:LC Event Webhook Ed25519 public key (base64 SPKI), from apidocs.erlc.gg/event-webhooks.
# Used to verify the X-Signature-Ed25519 header on every incoming webhook request.
ERLC_WEBHOOK_PUBLIC_KEY=

# Discord application/bot credentials.
DISCORD_APPLICATION_ID=
DISCORD_BOT_TOKEN=

# Proximity radius (ER:LC world studs) for ;ts and ;scene. Untested default — tune in-game.
ERLC_PROXIMITY_STUDS=60

# Set to "true" only after confirming TEAM_TO_DEPARTMENT (src/config.ts) and the reload/PM
# command templates below against real gameplay. Defaults to dry-run (log-only, no live action).
COMPLIANCE_ENFORCEMENT_ENABLED=false

# UNCONFIRMED command syntax — see src/config.ts comments. {username}/{message} placeholders.
ERLC_RELOAD_COMMAND_TEMPLATE=:load {username}
ERLC_PM_COMMAND_TEMPLATE=:pm {username} {message}
