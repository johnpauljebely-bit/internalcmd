    "opusscript": "^0.0.8",
    "pg": "^8.23.0",
    "prism-media": "^1.3.5",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "@types/pg": "^8.21.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
